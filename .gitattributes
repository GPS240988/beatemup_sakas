# Shell scripts and git hooks must use LF regardless of platform — CRLF
# breaks the shebang parser on Unix and breaks `post-checkout` everywhere.
script/*       text eol=lf
script/githooks/* text eol=lf
*.sh           text eol=lf
# ── Git LFS: binários pesados do jogo ──
# Godot web export (PCK cresce a cada asset novo)
*.pck filter=lfs diff=lfs merge=lfs -text
# WebAssembly engine binary
*.wasm filter=lfs diff=lfs merge=lfs -text
# Large raw media (vídeos)
*.ogv filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
