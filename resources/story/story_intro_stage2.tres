[sub_resource type="Resource" id="Resource_stage2_call"]
script = ExtResource("1_event")
id = "stage2_sergio_call"
event_type = "dialogue"
image_path = "res://assets/backgrounds/maps/fase2/story_churrasco_fase2_1.webp"
texts = Array[String](["Oi, Gabriel! Tudo bem com vocês? Está todo mundo aí?", "Tudo sim, Sérgio. O que aconteceu com a máquina?", "Ela começou a exibir um lugar estranho na tela. Não parece fazer parte do jogo. Achei melhor avisar vocês."])
speakers = Array[String](["SÉRGIO", "GABRIEL", "SÉRGIO"])
duration_per_text = 4.0
entry_effect = "slow_zoom"
exit_effect = "crossfade"
transition_duration = 0.45
pause_after = 0.25
zoom_end = 1.015

[sub_resource type="Resource" id="Resource_stage2_machine"]
script = ExtResource("1_event")
id = "stage2_machine_silent"
event_type = "revelation"
image_path = "res://assets/backgrounds/maps/fase2/story_happen_fase2_1.webp"
duration_per_text = 4.5
entry_effect = "crossfade"
exit_effect = "crossfade"
transition_duration = 0.45
pause_after = 0.2
hide_panel_initially = true

[sub_resource type="Resource" id="Resource_stage2_decision"]
script = ExtResource("1_event")
id = "stage2_churrasco_decision"
event_type = "dialogue"
image_path = "res://assets/backgrounds/maps/fase2/story_churrasco_fase2_1.webp"
texts = Array[String](["Se eu não me engano, esse lugar é uma antiga pizzaria que existia perto da Vila Ema.", "Você acha que a máquina está mostrando aquele lugar?", "É o que precisamos descobrir. Vamos até lá investigar."])
speakers = Array[String](["GABRIEL", "GUILHERME", "GABRIEL"])
duration_per_text = 4.0
entry_effect = "quick_dialogue_crossfade"
transition_duration = 0.45
pause_after = 0.3

[resource]
script = ExtResource("2_sequence")
sequence_id = "story_intro_stage2"
events = Array[Resource]([SubResource("Resource_stage2_call"), SubResource("Resource_stage2_machine"), SubResource("Resource_stage2_decision")])
