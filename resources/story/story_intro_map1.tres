image_path = "res://assets/story/map_1/street_memory.webp"
texts = Array[String](["Ao sair da sala secreta e voltar para a locadora,\neles perceberam que algo estava errado.", "Isso não estava assim quando entramos.", "Vocês também estão vendo?", "Será que é só a locadora.", "Então vamos descobrir o que está acontecendo."])
