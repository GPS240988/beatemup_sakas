[resource]
script = ExtResource("story_sequence")
sequence_id = "story_phase2_1_entry"
events = Array[Resource]( [SubResource("Dialogue_Alessandro"), SubResource("Dialogue_Guilherme"), SubResource("Dialogue_Andre"), SubResource("Dialogue_Gabriel")] )
